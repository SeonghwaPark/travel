# 이 파일을 .env 로 복사한 뒤 키를 채워넣으세요.
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# 항공권·숙소·액티비티 검색은 키 없이도 동작합니다.
# 아래 키는 "여행 일정" 탭(AI 일정 생성)에만 필요합니다.
# 둘 중 하나만 있어도 되고, 둘 다 있으면 OpenAI를 먼저 쓰고 실패 시 Groq로 넘어갑니다.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.groq.com/keys  (무료 등급 제공)
GROQ_API_KEY=
